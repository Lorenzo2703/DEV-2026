---
const title: string = 'Ship a static site';
const topics: string[] = ['Build', 'Test', 'Deploy'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <ul>
        {topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </main>
  </body>
</html>
