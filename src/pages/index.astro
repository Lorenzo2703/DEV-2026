---
import { getCollection } from 'astro:content';
import TechnologyPathways from '../components/TechnologyPathways.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const [blueprints, tools, guides] = await Promise.all([
  getCollection('blueprints', ({ data }) => !data.draft),
  getCollection('tools', ({ data }) => !data.draft),
  getCollection('guides', ({ data }) => !data.draft),
]);
const featuredBlueprints = [...blueprints]
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
const latestPost = [...guides]
  .filter((entry) => entry.data.publishedAt)
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))[0];
const statuses = ['adopt', 'trial', 'assess'] as const;
---

<SiteLayout
  title="Home"
  description="Practical, source-verified guides for building, shipping, and operating software."
>
  <section class="home-hero">
    <p class="home-eyebrow">A developer's handbook</p>
    <h1>Build and operate software with confidence.</h1>
    <p class="home-lede">
      Clear implementation guidance for the tools and systems developers rely on, grounded in
      current sources and runnable examples.
    </p>
    <div class="home-actions">
      <a class="home-button bg-brand !text-paper" href="/tools/">Browse tool guides</a>
      <a class="home-button" href="/radar/">Explore the radar</a>
    </div>
  </section>

  <TechnologyPathways tools={tools} />

  {latestPost && (
    <section class="home-section home-announcement" aria-labelledby="latest-announcement">
      <h2 id="latest-announcement" class="home-heading">Latest announcement</h2>
      <p>
        <a href={`/guides/${latestPost.id}/`}>{latestPost.data.title}</a>
        {' — '}{latestPost.data.summary}
      </p>
    </section>
  )}

  <section class="home-section" aria-labelledby="featured-blueprints">
    <div class="home-section-head">
      <h2 id="featured-blueprints" class="home-heading">Featured blueprints</h2>
      <a class="home-more" href="/blueprints/">Browse blueprints</a>
    </div>
    {featuredBlueprints.length ? (
      <ul class="home-grid home-grid-3">
        {featuredBlueprints.map((entry) => (
          <li class="home-card">
            <h3><a href={`/blueprints/${entry.id}/`}>{entry.data.title}</a></h3>
            <p>{entry.data.summary}</p>
          </li>
        ))}
      </ul>
    ) : <p class="home-muted">No blueprints have been published yet.</p>}
  </section>

  <section class="home-section" aria-labelledby="radar-overview">
    <div class="home-section-head">
      <h2 id="radar-overview" class="home-heading">Technology radar</h2>
      <a class="home-more" href="/radar/">Explore the radar</a>
    </div>
    <ul class="home-grid home-grid-4">
      {statuses.map((status) => (
        <li class="home-card home-stat">
          <h3>{status}</h3>
          <p>{tools.filter((entry) => entry.data.radar === status).length} tools</p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>

