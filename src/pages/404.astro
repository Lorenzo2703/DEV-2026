---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found" description="The requested page could not be found.">
  <h1 class="text-4xl font-bold">Page not found</h1>
  <p class="mt-4 text-lg text-muted">The page may have moved or may not have been published.</p>
  <a class="mt-6 inline-block" href="/">Return to the handbook home page</a>
</SiteLayout>
