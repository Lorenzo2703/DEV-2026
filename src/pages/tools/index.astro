---
import { getCollection } from 'astro:content';
import registrySource from '../../../docs/tool-registry.md?raw';
import ToolCard from '../../components/ToolCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = await getCollection('tools', ({ data }) => !data.draft);
const registryTools = [
  ...registrySource.matchAll(/^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*`([^`]+)`\s*\|/gm),
].map((match) => {
  const [, category, title, slug] = match;
  if (category === undefined || title === undefined || slug === undefined) {
    throw new Error('A tool registry row is missing its category, title, or slug.');
  }
  return { category: category.trim(), title: title.trim(), slug };
});
const publishedEntries = new Map(entries.map((entry) => [entry.id, entry]));
const catalog = registryTools.map((tool) => ({
  ...tool,
  entry: publishedEntries.get(`${tool.category}/${tool.slug}`),
}));
const registeredIds = new Set(catalog.map((tool) => `${tool.category}/${tool.slug}`));
for (const entry of entries) {
  if (!registeredIds.has(entry.id)) {
    catalog.push({
      category: entry.data.category,
      title: entry.data.title,
      slug: entry.id.slice(entry.id.lastIndexOf('/') + 1),
      entry,
    });
  }
}
catalog.sort((a, b) => a.title.localeCompare(b.title));
const categories = [...new Set(catalog.map((tool) => tool.category))].sort();
---

<SiteLayout title="Tools" description="Source-verified implementation guides for software tools.">
  <h1 class="text-4xl font-bold">All tools</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    Browse all {catalog.length} tools in the registry. Published guides are linked; planned guides
    are marked.
  </p>
  {
    catalog.length > 0 ? (
      <>
      <form id="tool-filters" class="mt-10" hidden>
        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 font-semibold">Category</legend>
          <div class="flex flex-wrap gap-2">
            <label class="category-chip">
              <input class="sr-only" type="radio" name="category" value="" checked />
              <span>All</span>
            </label>
            {categories.map((category) => (
              <label class="category-chip">
                <input class="sr-only" type="radio" name="category" value={category} />
                <span>{category.replaceAll('-', ' ')}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p id="filter-count" class="mt-3 text-sm text-muted" role="status" aria-live="polite"></p>
      </form>
      <ul id="tool-list" class="mt-10 grid list-none gap-6 p-0 md:grid-cols-2">
        {catalog.map((tool) => (
          <li
            data-tool
            data-category={tool.category}
          >
            {tool.entry ? (
              <ToolCard entry={tool.entry} />
            ) : (
              <article class="rounded-xl border border-slate-300/70 bg-white/70 p-6 dark:border-slate-700 dark:bg-slate-900">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p class="m-0 text-sm text-muted">{tool.category}</p>
                  <span class="rounded-full bg-brand-soft px-3 py-1 text-sm font-semibold text-ink">
                    Guide planned
                  </span>
                </div>
                <h2 class="mt-4 text-2xl font-bold">{tool.title}</h2>
              </article>
            )}
          </li>
        ))}
      </ul>
      </>
    ) : (
      <p class="mt-10 rounded-xl border border-dashed border-slate-400 p-8 text-muted">
        No tools have been added to the registry yet.
      </p>
    )
  }
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#tool-filters');
  if (form) {
    const filterForm = form;
    const tools = [...document.querySelectorAll<HTMLElement>('[data-tool]')];
    const count = document.querySelector<HTMLElement>('#filter-count');

    function updateFilters() {
      const selected = filterForm.querySelector<HTMLInputElement>('input[name="category"]:checked');
      if (!selected) throw new Error('No category filter is selected.');
      let visible = 0;
      for (const tool of tools) {
        const matches = !selected.value || tool.dataset.category === selected.value;
        tool.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = `${visible} ${visible === 1 ? 'tool' : 'tools'} found.`;
    }

    form.addEventListener('change', updateFilters);
    updateFilters();
    form.hidden = false;
  }
</script>
