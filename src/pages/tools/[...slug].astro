---
import { getCollection, render } from 'astro:content';
import MaturityBadge from '../../components/MaturityBadge.astro';
import VerifiedStamp from '../../components/VerifiedStamp.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tools', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const categoryEntries = (
  await getCollection('tools', ({ data }) => !data.draft && data.category === entry.data.category)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const position = categoryEntries.findIndex((item) => item.id === entry.id);
const previous = categoryEntries[position - 1];
const next = categoryEntries[position + 1];
const readingMinutes = entry.body
  ? Math.max(1, Math.ceil(entry.body.trim().split(/\s+/).length / 200))
  : null;
---

<SiteLayout title={entry.data.title} description={entry.data.summary} category={entry.data.category} image={`/og/tools/${entry.id}.png`} article>
  <article class="prose mx-auto max-w-3xl">
    <a href="/tools/">← All tools</a>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <MaturityBadge maturity={entry.data.maturity} />
      <VerifiedStamp verifiedAt={entry.data.verifiedAt} maturity={entry.data.maturity} needsVerification={entry.data.needsVerification} />
    </div>
    <h1 class="mt-5 text-4xl font-bold">{entry.data.title}</h1>
    <p class="text-xl text-muted">{entry.data.summary}</p>
    {readingMinutes && <p class="text-sm text-muted">{readingMinutes} min read</p>}
    {entry.data.tags.length > 0 && (
      <p>Topics: {entry.data.tags.map((tag, index) => (
        <>{index > 0 && ', '}<a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></>
      ))}</p>
    )}
    {sections.length > 0 && (
      <nav aria-label="On this page" class="table-of-contents table-of-contents-compact">
        <p class="m-0 font-bold">On this page</p>
        <ol>
          {sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
        </ol>
      </nav>
    )}
    <Content />
    {(previous || next) && (
      <nav aria-label="More in this category" class="mt-12 flex flex-wrap justify-between gap-4 border-t border-slate-300/70 pt-6 dark:border-slate-700">
        {previous && <a href={`/tools/${previous.id}/`}>Previous: {previous.data.title}</a>}
        {next && <a href={`/tools/${next.id}/`}>Next: {next.data.title}</a>}
      </nav>
    )}
  </article>
</SiteLayout>
