---
import { getCollection } from 'astro:content';
import MaturityBadge from '../../components/MaturityBadge.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const [entries, decisions] = await Promise.all([
  getCollection('tools', ({ data }) => !data.draft),
  getCollection('radar', ({ data }) => !data.draft),
]);
const rings = [
  { status: 'adopt', description: 'A dependable default when it fits your requirements.' },
  { status: 'trial', description: 'Use in a bounded project and measure the cost first.' },
  { status: 'assess', description: 'Explore the fit and risks before committing.' },
].map((ring) => ({
  ...ring,
  tools: entries
    .filter((entry) => entry.data.radar === ring.status)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  notes: decisions
    .filter((entry) => entry.data.status === ring.status)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));
---

<SiteLayout title="Radar" description="A maturity-aware view of tools evaluated in this handbook.">
  <div class="radar-page">
    <header class="radar-header">
      <h1>Technology radar</h1>
      <p>What to reach for, what to try, and what to explore first.</p>
    </header>

    <nav aria-label="Recommendation rings" class="radar-nav">
      {rings.map((ring) => (
        <a href={`#radar-${ring.status}`}>{ring.status} <span>{ring.tools.length}</span></a>
      ))}
    </nav>

    <div class="radar-rings">
      {rings.map((ring) => (
        <section aria-labelledby={`radar-${ring.status}`} class="radar-ring">
          <div class="ring-head">
            <h2 id={`radar-${ring.status}`} tabindex="-1">{ring.status}</h2>
            <p>{ring.description}</p>
          </div>
          <div class="ring-body">
            {ring.notes.length > 0 && (
              <ul class="ring-notes" aria-label={`${ring.status} decision notes`}>
                {ring.notes.map((note) => (
                  <li>
                    <a href={`/radar/${note.id}/`}>{note.data.title}</a>
                    <p>{note.data.summary}</p>
                  </li>
                ))}
              </ul>
            )}
            {ring.tools.length ? (
              <ul class="radar-tools" aria-label={`${ring.status} tools`}>
                {ring.tools.map((tool) => (
                  <li>
                    <a href={`/tools/${tool.id}/`}>{tool.data.title}</a>
                    <MaturityBadge maturity={tool.data.maturity} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="radar-empty">No tools in this ring yet.</p>
            )}
          </div>
        </section>
      ))}
    </div>

    <p class="radar-footnote">
      Rings describe adoption guidance; maturity describes a tool's lifecycle.
      <a href="/guides/choosing-a-stack/">Choose a stack by its boundaries</a>
    </p>
  </div>
</SiteLayout>

<style>
  .radar-page {
    --radar-border: color-mix(in srgb, var(--color-ink) 14%, transparent);
    max-width: 56rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .radar-header p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.15rem;
  }
  .radar-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
  }
  .radar-nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-weight: 600;
    text-transform: capitalize;
  }
  .radar-nav span {
    color: var(--color-muted);
    font-weight: 400;
  }
  .radar-rings {
    margin-top: 2rem;
    border-bottom: 1px solid var(--radar-border);
  }
  .radar-ring {
    display: grid;
    gap: 1rem 3rem;
    align-items: start;
    border-top: 1px solid var(--radar-border);
    padding: 2rem 0;
  }
  @media (min-width: 48rem) {
    .radar-ring {
      grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 2fr);
    }
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-transform: capitalize;
    scroll-margin-top: 2rem;
  }
  h2:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 4px;
  }
  .ring-head p {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ring-notes {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .ring-notes a {
    font-weight: 650;
  }
  .ring-notes p {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .radar-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.375rem;
  }
  @media (min-width: 64rem) {
    .radar-tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .radar-tools li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.5rem;
    min-height: 2.75rem;
    border: 1px solid var(--radar-border);
    border-radius: 0.5rem;
    background: #18212f;
    color: #fff;
    padding: 0.125rem 0.375rem;
  }
  .radar-tools a {
    min-width: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .radar-tools :global(.maturity-stable),
  .radar-tools :global(.maturity-frontier),
  .radar-tools :global(.maturity-legacy),
  .radar-tools :global(.maturity-deprecated) {
    padding: 0.0625rem 0.375rem;
    font-size: 0.6875rem;
    line-height: 1.2;
  }
  .radar-tools .maturity-stable {
    background: #15583b;
    color: #fff;
  }
  .radar-tools .maturity-frontier {
    background: #673c00;
    color: #fff;
  }
  .radar-tools .maturity-legacy {
    background: #334155;
    color: #fff;
  }
  .radar-tools .maturity-deprecated {
    background: #7f1d1d;
    color: #fff;
  }
  .radar-empty {
    margin: 0;
    color: var(--color-muted);
  }
  .radar-footnote {
    margin-top: 2rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
