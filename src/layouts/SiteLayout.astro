---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  category?: string;
  image?: string;
  article?: boolean;
}

const { title, description, category, image = '/og/site.png', article = false } = Astro.props;
const pageTitle = title === 'Home' ? 'Dev in 2026' : `${title} | Dev in 2026`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = Astro.site ? new URL(image, Astro.site).href : undefined;
const analyticsScript = process.env.UMAMI_SCRIPT_PATH;
const analyticsHost = process.env.UMAMI_HOST_URL;
const analyticsId = process.env.UMAMI_WEBSITE_ID;
const structuredData =
  article && canonical && imageUrl
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: canonical,
        image: imageUrl,
      }).replaceAll('<', '\\u003c')
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={pageTitle} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    {analyticsScript && analyticsHost && analyticsId && Astro.site && (
      <script is:inline defer src={analyticsScript} data-website-id={analyticsId} data-host-url={analyticsHost} data-domains={Astro.site.hostname} data-exclude-search="true" data-exclude-hash="true" data-do-not-track="true"></script>
    )}
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="Dev in 2026" href="/rss.xml" />}
    {Astro.site && category && <link rel="alternate" type="application/rss+xml" title={`${category} tool guides`} href={`/feeds/${category}.xml`} />}
    <meta name="generator" content={Astro.generator} />
    {category && <meta data-pagefind-filter="category[content]" content={category} />}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (error) {
        console.error('Could not read the theme preference:', error);
      }
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="border-b border-slate-300/70 px-6 py-5 dark:border-slate-700">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
        <a class="text-xl font-bold no-underline" href="/">Dev in 2026</a>
        <nav aria-label="Main navigation">
          <ul class="flex flex-wrap gap-5 p-0">
            <li class="list-none"><a href="/tools/">Tools</a></li>
            <li class="list-none"><a href="/guides/">Guides &amp; posts</a></li>
            <li class="list-none"><a href="/blueprints/">Blueprints</a></li>
            <li class="list-none"><a href="/radar/">Radar</a></li>
          </ul>
        </nav>
        <div id="theme-control" class="flex items-center gap-2" hidden>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark mode"
            title="Switch to dark mode"
          >
            <svg id="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
            <svg id="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="M20.5 15.2A8 8 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" />
            </svg>
          </button>
        </div>
      </div>
      <p id="theme-status" class="mx-auto max-w-6xl text-sm" aria-live="polite"></p>
    </header>
    <div class="pointer-glow" aria-hidden="true"></div>
    <main id="main" class="mx-auto min-h-[70vh] max-w-6xl px-6 py-12" data-pagefind-body>
      <slot />
    </main>
    <footer></footer>
  </body>
</html>

<script>
  const control = document.querySelector<HTMLElement>('#theme-control');
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const sunIcon = document.querySelector<SVGSVGElement>('#theme-sun');
  const moonIcon = document.querySelector<SVGSVGElement>('#theme-moon');
  const status = document.querySelector<HTMLElement>('#theme-status');
  if (control && toggle && sunIcon && moonIcon && status) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
    const getTheme = () =>
      document.documentElement.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');

    const updateControls = () => {
      const currentTheme = getTheme();
      const targetTheme = currentTheme === 'dark' ? 'light' : 'dark';
      const label = `Switch to ${targetTheme} mode`;
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
      sunIcon.style.display = currentTheme === 'light' ? '' : 'none';
      moonIcon.style.display = currentTheme === 'dark' ? '' : 'none';
    };

    const setTheme = (theme: 'light' | 'dark') => {
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
        status.textContent = '';
      } catch (error) {
        console.error('Could not save the theme preference:', error);
        status.textContent = 'Your theme preference could not be saved for future visits.';
      }
      updateControls();
    };

    control.hidden = false;
    updateControls();
    toggle.addEventListener('click', () => {
      setTheme(getTheme() === 'dark' ? 'light' : 'dark');
    });
    prefersDark.addEventListener('change', () => {
      if (!document.documentElement.dataset.theme) updateControls();
    });
  }

  const pointerGlow = document.querySelector<HTMLElement>('.pointer-glow');
  if (
    pointerGlow &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    let frame = 0;
    let x = 0;
    let y = 0;
    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        x = event.clientX;
        y = event.clientY;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          pointerGlow.style.setProperty('--pointer-x', `${x}px`);
          pointerGlow.style.setProperty('--pointer-y', `${y}px`);
          pointerGlow.dataset.active = 'true';
        });
      },
      { passive: true },
    );
    window.addEventListener('pointerleave', () => {
      delete pointerGlow.dataset.active;
    });
  }
</script>
