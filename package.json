{
  "name": "dev-in-2026",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && bun run scripts/check-js-budget.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && biome ci .",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "snippets": "bun run scripts/run-snippets.ts",
    "verify:content": "bun run scripts/verify-content.ts",
    "stale-report": "bun run scripts/stale-report.ts",
    "links": "lychee --no-progress --include-fragments --root-dir dist src docs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@electric-sql/pglite": "0.5.16",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "pnpm": "12.18.0",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0",
    "yarn": "1.22.22"
  }
}
