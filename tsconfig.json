{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "snippets/astro/.astro",
    "snippets/astro/dist",
    "snippets/nextjs/.next",
    "snippets/nextjs/out",
    "snippets/rust/target",
    "snippets/tailwind-css/.astro",
    "snippets/tailwind-css/dist"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  }
}
